# Copy to config.env and edit. Every script and both Terraform stacks read their settings from config.env.

# AWS account access. Leave AWS_PROFILE empty to use the default credential chain (environment variables, SSO, ...).
AWS_PROFILE=sales
AWS_REGION=us-east-1
OWNER=you@example.com

# EKS clusters (also the kubectl context names) and their VPCs. The two CIDRs must not overlap.
CORE_CLUSTER=cfk-eks
DMZ_CLUSTER=cfk-dmz
CORE_VPC_CIDR=10.0.0.0/16
DMZ_VPC_CIDR=10.1.0.0/16

# DNS. PARENT_ZONE is an existing public Route 53 zone in this account; Terraform creates PUBLIC_ZONE under it and
# delegates it. Public names: kafka.gateway.<PUBLIC_ZONE> (Gateway) and sr.<PUBLIC_ZONE> (Schema Registry).
# PRIVATE_ZONE is a new private zone shared by both VPCs (brokers, MDS, Schema Registry, Loki).
PARENT_ZONE=example.com
PUBLIC_ZONE=wf.example.com
PRIVATE_ZONE=internal.example.com

# Source CIDRs allowed to reach the public Gateway and Schema Registry endpoints, comma separated.
PUBLIC_ALLOWED_CIDRS=0.0.0.0/0

# Confluent Platform license (the raw JWT, with the CSFLE add-on for the encryption rules).
CONFLUENT_LICENSE_FILE=.secrets/confluent-license.txt
